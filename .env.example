# .env.example
#
# Names only — never real values. Copy to .env.local and fill in.
# .env* is gitignored, so this file is the only record of what the app needs.

# ─── Supabase ────────────────────────────────────────────────────────────
# The URL and anon key are public by design: they ship in the browser bundle,
# and Row Level Security is what protects the data behind them. The service
# role key bypasses RLS entirely — server-side only, never NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ────────────────────────────────────────────────────────────────
# The single origin the whole OAuth round trip happens on. Must match the
# redirect URL registered in Supabase Auth and the authorised origin in Google
# Cloud, or sign-in breaks in ways that are painful to debug.
NEXT_PUBLIC_URL=

# ─── OpenAI ──────────────────────────────────────────────────────────────
# Set a hard spend cap in the OpenAI dashboard as well as this key. The key
# alone has no limit attached to it.
OPENAI_API_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────
# Test keys locally, live keys in production. The webhook secret is specific
# to each endpoint you create — a live endpoint has a different secret from a
# test one, and using the wrong one fails every event silently.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs from the Stripe Dashboard. Prices are immutable, so changing a
# price means creating a new Price object and pointing these at it.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_FULL=
STRIPE_PRICE_FOLLOWUP=
STRIPE_PRICE_TOPUP=

# Optional Checkout branding. Both must be publicly reachable URLs — pointing
# Stripe at a 404 makes session creation fail, taking checkout down.
STRIPE_CHECKOUT_LOGO_URL=
STRIPE_CHECKOUT_ICON_URL=

# Set to "true" ONLY after adding a terms-of-service URL under
# Settings -> Checkout in the Stripe Dashboard. Requiring consent without that
# URL configured makes every checkout session fail.
STRIPE_REQUIRE_TOS=

# ─── Upstash Redis (rate limiting) ───────────────────────────────────────
# Read by Redis.fromEnv() in lib/rate-limit.ts, which expects these exact names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Email (Resend) ──────────────────────────────────────────────────────
# Unset until you set up a provider. Without it lib/email.ts logs what it
# would have sent and returns, so nothing breaks — receipts simply do not go
# out yet. EMAIL_FROM should be a SENDING SUBDOMAIN, not the root domain, so a
# spam flag on marketing mail cannot take down receipts and sign-in links.
RESEND_API_KEY=
EMAIL_FROM=

# ─── Sentry ──────────────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN=
